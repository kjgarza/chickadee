---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}{{ '/' | url }}</loc><priority>1.0</priority></url>
  <url><loc>{{ site.url }}{{ '/about/' | url }}</loc><priority>0.8</priority></url>
  <url><loc>{{ site.url }}{{ '/contact/' | url }}</loc><priority>0.6</priority></url>
  <url><loc>{{ site.url }}{{ '/support/' | url }}</loc><priority>0.5</priority></url>
  <url><loc>{{ site.url }}{{ '/privacy/' | url }}</loc><priority>0.3</priority></url>
  <url><loc>{{ site.url }}{{ '/terms/' | url }}</loc><priority>0.3</priority></url>
  {% for slug, recipe in recipes %}
  <url><loc>{{ site.url }}{{ ('/recipes/' + slug + '/') | url }}</loc><priority>0.9</priority></url>
  {% endfor %}
</urlset>
